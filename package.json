{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint",
    "sync-rules": "node -e \"const fs = require('fs'); fs.mkdirSync('.cursor/rules', { recursive: true }); fs.mkdirSync('.github', { recursive: true }); fs.copyFileSync('tech-stack.mdc', '.cursor/rules/tech-stack.mdc'); fs.copyFileSync('tech-stack.mdc', '.coderules'); fs.writeFileSync('.github/copilot-instructions.md', '# GitHub Copilot Instructions\\n@tech-stack.mdc'); console.log('✅ ¡Reglas sincronizadas en todo el ecosistema!');\""
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "core-js": "^3.8.3",
    "gsap": "^3.15.0",
    "vue": "^3.2.13",
    "vue-i18n": "^11.4.0",
    "vue-router": "^4.6.4",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@tailwindcss/postcss": "^4.2.4",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "postcss": "^8.5.13",
    "tailwindcss": "^4.2.4"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "globals": {
      "defineProps": "readonly",
      "defineEmits": "readonly",
      "defineExpose": "readonly",
      "withDefaults": "readonly",
      "beforeCreate": "readonly",
      "created": "readonly",
      "beforeMount": "readonly",
      "mounted": "readonly",
      "beforeUpdate": "readonly",
      "updated": "readonly",
      "beforeUnmount": "readonly",
      "unmounted": "readonly",
      "activated": "readonly",
      "deactivated": "readonly",
      "errorCaptured": "readonly",
      "renderTracked": "readonly",
      "renderTriggered": "readonly",
      "beforeDestroy": "readonly",
      "destroyed": "readonly"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
